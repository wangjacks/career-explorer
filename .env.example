# Career Explorer 环境变量模板
# 用法：cp .env.example .env.local 后填写（.env.local 已被 gitignore）

# [必需] JWT 签名密钥：随机字符串（建议 32 位以上）
# 未设置会回退到代码内置的不安全默认值，生产环境必须配置
JWT_SECRET=

# [可选] Google Fonts 镜像前缀：官方域名访问不畅的环境配置（构建时生效）
# 示例：https://fonts.loli.net；不设置默认 https://fonts.googleapis.com
#FONT_CDN_PREFIX=

# [仅开发] Next.js 开发服务器 origin 白名单（逗号分隔），生产环境无效
#ALLOWED_ORIGINS=

# [可选] 站点公网地址：班级邀请海报二维码使用的绝对链接基址（#102）
# 未设置时回退到生成海报时的请求 origin；生产环境建议显式配置为域名，
# 例如 https://career.example.com
#NEXT_PUBLIC_APP_URL=

# [可选] 对象存储凭据（#111）：仅在管理面板「系统设置 → 存储管理」注册了
# S3 兼容后端（腾讯云 COS / 阿里云 OSS / MinIO / AWS S3）时需要。
# {后端ID} 替换为创建后端时返回的 ID（对应数据库 storage_backends.id），例如 ID 为 2：
# 凭据只走环境变量、不入库；备份恢复后需在新环境重新配置。
#S3_2_ACCESS_KEY=
#S3_2_SECRET_KEY=

# [可选] 极验行为验证（#155）：登录页与激活页第一步（身份核验）的人机验证。
# 两个变量需同时配置；任一缺失或极验服务不可达时按 fail-open 降级放行，
# 并记录 auth:captcha-degraded 审计事件（策略见 docs/architecture.md）。
# NEXT_PUBLIC_GEETEST_CAPTCHA_ID 为验证 ID（公开值，供前端初始化）；
# GEETEST_PRIVATE_KEY 为私钥（仅服务端生成 sign_token，绝不提交或写入日志）。
#NEXT_PUBLIC_GEETEST_CAPTCHA_ID=
#GEETEST_PRIVATE_KEY=

# 变量清单的权威说明见 docs/standards.md §11；新增变量时两处须同步。
